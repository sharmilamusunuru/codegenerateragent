<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example draw.io architecture diagram for bicep-generator-agent.
  This diagram represents a typical 3-tier Azure web application:
    - API Management (public entry point)
    - App Service (web tier)
    - Azure SQL (data tier)
    - Key Vault (secrets)
    - Virtual Network with subnets
    - Storage Account (blobs)
-->
<mxfile host="bicep-generator-agent" modified="2024-01-01T00:00:00.000Z" agent="bicep-generator-agent" version="21.0.0">
  <diagram id="main-diagram" name="Azure 3-Tier Architecture">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Virtual Network -->
        <mxCell id="vnet1"
                value="Main VNet"
                style="shape=mxgraph.azure.network.vnet;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;image;aspect=fixed;"
                vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Subnet -->
        <mxCell id="subnet1"
                value="App Subnet"
                style="shape=mxgraph.azure.network.subnet;sketch=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- App Service -->
        <mxCell id="app1"
                value="Web App"
                style="shape=mxgraph.azure.compute.app_service;sketch=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- API Management -->
        <mxCell id="apim1"
                value="API Gateway"
                style="shape=mxgraph.azure.integration.api_management;sketch=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Azure SQL Server -->
        <mxCell id="sql1"
                value="SQL Server"
                style="shape=mxgraph.azure.databases.sql;sketch=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Key Vault -->
        <mxCell id="kv1"
                value="Key Vault"
                style="shape=mxgraph.azure.security.key_vault;sketch=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="200" y="220" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Storage Account -->
        <mxCell id="storage1"
                value="Blob Storage"
                style="shape=mxgraph.azure.storage.storageaccount;sketch=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Virtual Machine -->
        <mxCell id="vm1"
                value="Bastion VM"
                style="shape=mxgraph.azure.compute.vm;sketch=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="100" y="220" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Connections / Edges -->

        <!-- VNet → Subnet -->
        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="vnet1" target="subnet1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Subnet → App Service -->
        <mxCell id="edge2" value="hosts" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="subnet1" target="app1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- APIM → App Service -->
        <mxCell id="edge3" value="routes to" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="apim1" target="app1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- App Service → SQL -->
        <mxCell id="edge4" value="reads/writes" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="app1" target="sql1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- App Service → Key Vault -->
        <mxCell id="edge5" value="reads secrets" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="app1" target="kv1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- App Service → Storage -->
        <mxCell id="edge6" value="stores blobs" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="app1" target="storage1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- VNet → VM -->
        <mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="vnet1" target="vm1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
