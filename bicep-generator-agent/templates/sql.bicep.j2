// ============================================================
// Azure SQL Server + Database module
// Generated by bicep-generator-agent
// ============================================================
param location string = resourceGroup().location
param namingPrefix string
param environment string
param tags object = {}

@description('SQL administrator login')
param administratorLogin string = 'sqladmin'

@description('SQL administrator password – use Key Vault reference in production')
@secure()
param administratorLoginPassword string

@description('Database SKU name')
param databaseSkuName string = 'Basic'

@description('Database tier')
param databaseTier string = 'Basic'

var sqlServerName = '${namingPrefix}-sql-${environment}'
var databaseName = '${namingPrefix}-db-${environment}'

resource sqlServer 'Microsoft.Sql/servers@2022-05-01-preview' = {
  name: sqlServerName
  location: location
  tags: union(tags, { resourceType: 'sqlServer' })
  properties: {
    administratorLogin: administratorLogin
    administratorLoginPassword: administratorLoginPassword
    minimalTlsVersion: '1.2'
    publicNetworkAccess: 'Disabled'
  }
  identity: {
    type: 'SystemAssigned'
  }
}

resource database 'Microsoft.Sql/servers/databases@2022-05-01-preview' = {
  parent: sqlServer
  name: databaseName
  location: location
  tags: tags
  sku: {
    name: databaseSkuName
    tier: databaseTier
  }
  properties: {
    collation: 'SQL_Latin1_General_CP1_CI_AS'
  }
}

output sqlServerId string = sqlServer.id
output sqlServerFqdn string = sqlServer.properties.fullyQualifiedDomainName
output databaseId string = database.id
